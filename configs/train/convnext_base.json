{
  "mode": "train",
  "seed": 1,
  "data_augment": true,
  "dataset": "imagenet",
  "optimizer": "adamw",
  "learning_rate": 0.0003,
  "weight_decay": 0.05,
  "grad_clip": 0,
  "lr_scheduler": "cosineannealinglr",
  "label_smoothing": 0.1,
  "num_epochs": 90,
  "warmup_epochs": 5,
  "log_interval": 10,
  "checkpoint_interval": 50,
  "batchsize": 32,
  "num_workers": 32,
  "use_amp": true,
  "log_checkpoints": true,
  "checkpoint_dir": "convnext_base_standard",
  "use_wandb": false,
  "pca_labels": false,
  "pca_n_classes": 32,
  "pca_labels_folder": "pca_labels_alexnet",
  "model_class": "standard_model",
  "standard_model": {
    "model_name": "ConvNeXt_Base",
    "pretrained_dataset": "none"
  }
}
