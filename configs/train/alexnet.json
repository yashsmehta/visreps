{
  "mode": "train",
  "seed": 1,
  "data_augment": true,
  "dataset": "imagenet",
  "optimizer": "sgd",
  "learning_rate": 0.01,
  "weight_decay": 0.0001,
  "grad_clip": 0,
  "lr_scheduler": "steplr",
  "label_smoothing": 0.1,
  "num_epochs": 90,
  "warmup_epochs": 0,
  "log_interval": 10,
  "checkpoint_interval": 30,
  "batchsize": 32,
  "num_workers": 32,
  "use_amp": false,
  "log_checkpoints": true,
  "checkpoint_dir": "alexnet_standard",
  "use_wandb": false,
  "pca_labels": false,
  "pca_n_classes": 32,
  "pca_labels_folder": "pca_labels_alexnet",
  "model_class": "standard_model",
  "standard_model": {
    "model_name": "AlexNet",
    "pretrained_dataset": "none"
  }
}
