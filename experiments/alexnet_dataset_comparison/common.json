{
  "mode": "train",
  "seed": 1,
  "dataset": "imagenet",
  "imagenet_backend": "folder",
  "model_class": "standard_model",
  "standard_model": {
    "model_name": "AlexNet",
    "pretrained_dataset": "none"
  },
  "dropout": 0.3,
  "data_augment": true,
  "augment_type": "mild",
  "image_size": 224,
  "batchsize": 32,
  "num_workers": 32,
  "optimizer": "adamw",
  "learning_rate": 0.0005,
  "weight_decay": 0.001,
  "grad_clip": 1.0,
  "lr_scheduler": "cosineannealinglr",
  "num_epochs": 20,
  "warmup_epochs": 2,
  "label_smoothing": 0.1,
  "use_amp": true,
  "log_interval": 10,
  "checkpoint_interval": 10,
  "log_checkpoints": true,
  "use_wandb": false,
  "pca_labels": false,
  "pca_n_classes": 2,
  "pca_labels_folder": "imagenet1k"
}
